{
  "entity": "Employees",
  "projection": [
    {
      "fields": [
        {
          "kind": "field",
          "field": "Department.Name"
        }
      ],
      "alias": "Department"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "COUNT",
          "arguments": [
            {
              "kind": "field",
              "field": "Id"
            }
          ]
        }
      ],
      "alias": "Headcount"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "function",
              "function": "AVG",
              "arguments": [
                {
                  "kind": "field",
                  "field": "Salary"
                }
              ]
            },
            {
              "kind": "value",
              "value": 2
            }
          ]
        }
      ],
      "alias": "AverageSalary"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "function",
              "function": "SUM",
              "arguments": [
                {
                  "kind": "field",
                  "field": "Salary"
                }
              ]
            },
            {
              "kind": "value",
              "value": 2
            }
          ]
        }
      ],
      "alias": "AnnualPayroll"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "function",
              "function": "AVG",
              "arguments": [
                {
                  "kind": "field",
                  "field": "ReviewSummary.AverageRating"
                }
              ]
            },
            {
              "kind": "value",
              "value": 2
            }
          ]
        }
      ],
      "alias": "AverageRating"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "function",
              "function": "SUM",
              "arguments": [
                {
                  "kind": "function",
                  "function": "Coalesce",
                  "arguments": [
                    {
                      "kind": "field",
                      "field": "ReviewSummary.Bonuses"
                    },
                    {
                      "kind": "value",
                      "value": 0
                    }
                  ]
                }
              ]
            },
            {
              "kind": "value",
              "value": 2
            }
          ]
        }
      ],
      "alias": "TotalBonuses"
    }
  ],
  "sorts": [
    {
      "field": "AnnualPayroll",
      "direction": "Descending"
    }
  ],
  "page": 1,
  "pageSize": 10,
  "contexts": [
    {
      "name": "ReviewSummary",
      "alias": "ReviewSummary",
      "joinType": "Left",
      "condition": "Id = ReviewSummary.EmployeeId",
      "query": {
        "entity": "PerformanceReviews",
        "projection": [
          {
            "fields": [
              {
                "kind": "field",
                "field": "EmployeeId"
              }
            ],
            "alias": "EmployeeId"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "AVG",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "Rating"
                  }
                ]
              }
            ],
            "alias": "AverageRating"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "SUM",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "BonusAmount"
                  }
                ]
              }
            ],
            "alias": "Bonuses"
          }
        ],
        "filter": "ReviewYear = 2025"
      }
    }
  ]
}
