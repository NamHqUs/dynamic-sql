{
  "entity": "Employees",
  "projection": [
    {
      "fields": [
        {
          "kind": "field",
          "field": "Id"
        }
      ],
      "alias": "DoctorId"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "Concat",
          "arguments": [
            {
              "kind": "field",
              "field": "FirstName"
            },
            {
              "kind": "value",
              "value": " "
            },
            {
              "kind": "field",
              "field": "LastName"
            }
          ]
        }
      ],
      "alias": "Physician"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Department.Name"
        }
      ],
      "alias": "Department"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Location.City"
        }
      ],
      "alias": "ClinicCity"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "DoctorVisits.VisitCount"
        }
      ],
      "alias": "VisitCount"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "DoctorVisits.PatientCount"
        }
      ],
      "alias": "PatientCount"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "field",
              "field": "DoctorVisits.AverageVisitMinutes"
            },
            {
              "kind": "value",
              "value": 1
            }
          ]
        }
      ],
      "alias": "AverageVisitMinutes"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "field",
              "field": "DoctorVisits.Charges"
            },
            {
              "kind": "value",
              "value": 2
            }
          ]
        }
      ],
      "alias": "Charges"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "group",
              "fields": [
                {
                  "kind": "value",
                  "value": 100.0
                },
                {
                  "oper": "*",
                  "kind": "function",
                  "function": "SUM",
                  "arguments": [
                    {
                      "kind": "function",
                      "function": "Coalesce",
                      "arguments": [
                        {
                          "kind": "field",
                          "field": "DoctorLabs.AbnormalCount"
                        },
                        {
                          "kind": "value",
                          "value": 0
                        }
                      ]
                    }
                  ]
                },
                {
                  "oper": "/",
                  "kind": "function",
                  "function": "NULLIF",
                  "arguments": [
                    {
                      "kind": "function",
                      "function": "SUM",
                      "arguments": [
                        {
                          "kind": "function",
                          "function": "Coalesce",
                          "arguments": [
                            {
                              "kind": "field",
                              "field": "DoctorLabs.LabCount"
                            },
                            {
                              "kind": "value",
                              "value": 0
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "kind": "value",
                      "value": 0
                    }
                  ]
                }
              ]
            },
            {
              "kind": "value",
              "value": 2
            }
          ]
        }
      ],
      "alias": "AbnormalLabPercent"
    }
  ],
  "filter": "Department.Name = 'Primary Care' OR Department.Name = 'Specialty Care' OR Department.Name = 'Emergency Medicine'",
  "sorts": [
    {
      "field": "VisitCount",
      "direction": "Descending"
    },
    {
      "field": "Charges",
      "direction": "Descending"
    }
  ],
  "page": 1,
  "pageSize": 10,
  "contexts": [
    {
      "name": "DoctorVisits",
      "alias": "DoctorVisits",
      "joinType": "Left",
      "condition": "Id = DoctorVisits.DoctorId",
      "query": {
        "entity": "Visits",
        "projection": [
          {
            "fields": [
              {
                "kind": "field",
                "field": "DoctorId"
              }
            ],
            "alias": "DoctorId"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "CountDistinct",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "Id"
                  }
                ]
              }
            ],
            "alias": "VisitCount"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "CountDistinct",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "UserId"
                  }
                ]
              }
            ],
            "alias": "PatientCount"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "AVG",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "DurationMinutes"
                  }
                ]
              }
            ],
            "alias": "AverageVisitMinutes"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "SUM",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "Charge"
                  }
                ]
              }
            ],
            "alias": "Charges"
          }
        ],
        "filter": "Status = 'Completed'"
      }
    },
    {
      "name": "DoctorLabs",
      "alias": "DoctorLabs",
      "joinType": "Left",
      "condition": "Id = DoctorLabs.DoctorId",
      "query": {
        "entity": "LabResults",
        "projection": [
          {
            "fields": [
              {
                "kind": "field",
                "field": "Visit.DoctorId"
              }
            ],
            "alias": "DoctorId"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "COUNT",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "Id"
                  }
                ]
              }
            ],
            "alias": "LabCount"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "CountIf",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "IsAbnormal = true"
                  }
                ]
              }
            ],
            "alias": "AbnormalCount"
          }
        ]
      }
    }
  ]
}
