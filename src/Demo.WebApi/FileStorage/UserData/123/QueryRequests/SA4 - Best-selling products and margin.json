{
  "Name": "SA4 - Best-selling products and margin",
  "Projection": [
    { "Fields": [{ "kind": "field", "field": "Product.Id" }], "Alias": "ProductId" },
    { "Fields": [{ "kind": "field", "field": "Product.Name" }], "Alias": "Product" },
    { "Fields": [{ "kind": "field", "field": "Product.Category" }], "Alias": "Category" },
    { "Fields": [{ "kind": "function", "function": "SUM", "arguments": [{ "kind": "field", "field": "Quantity" }] }], "Alias": "UnitsSold" },
    { "Fields": [{ "kind": "function", "function": "CountDistinct", "arguments": [{ "kind": "field", "field": "Order.Id" }] }], "Alias": "OrderCount" },
    {
      "Fields": [{
        "kind": "function", "function": "ROUND", "arguments": [{
          "kind": "function", "function": "SUM", "arguments": [{
            "kind": "group", "fields": [
              { "kind": "field", "field": "Quantity" },
              { "oper": "*", "kind": "field", "field": "UnitPrice" },
              { "oper": "-", "kind": "field", "field": "DiscountAmount" }
            ]
          }]
        }, { "kind": "value", "value": 2 }]
      }],
