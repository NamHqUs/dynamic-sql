    },
    {
      "Fields": [{
        "kind": "function", "function": "ROUND", "arguments": [{
          "kind": "function", "function": "SUM", "arguments": [{
            "kind": "group", "fields": [
              { "kind": "field", "field": "Quantity" },
              { "oper": "*", "kind": "group", "fields": [
                { "kind": "field", "field": "UnitPrice" },
                { "oper": "-", "kind": "field", "field": "Product.CostPrice" }
              ] },
              { "oper": "-", "kind": "field", "field": "DiscountAmount" }
            ]
          }]
        }, { "kind": "value", "value": 2 }]
      }],
      "Alias": "GrossProfit"
    },
    {
      "Fields": [{
        "kind": "function", "function": "ROUND", "arguments": [{
          "kind": "group", "fields": [
            { "kind": "value", "value": 100 },
            { "oper": "*", "kind": "function", "function": "SUM", "arguments": [{
              "kind": "group", "fields": [
                { "kind": "field", "field": "Quantity" },
                { "oper": "*", "kind": "group", "fields": [
                  { "kind": "field", "field": "UnitPrice" },
                  { "oper": "-", "kind": "field", "field": "Product.CostPrice" }
                ] },
                { "oper": "-", "kind": "field", "field": "DiscountAmount" }
              ]
            }] },
            { "oper": "/", "kind": "function", "function": "NULLIF", "arguments": [
              { "kind": "function", "function": "SUM", "arguments": [{
                "kind": "group", "fields": [
                  { "kind": "field", "field": "Quantity" },
                  { "oper": "*", "kind": "field", "field": "UnitPrice" },
                  { "oper": "-", "kind": "field", "field": "DiscountAmount" }
                ]
