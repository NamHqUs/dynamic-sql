{
  "Name": "HR3 - Workforce composition by location",
  "Entity": "Locations",
  "Projection": [
    {
      "fields": [
        {
          "kind": "field",
          "field": "City"
        }
      ],
      "alias": "OfficeCity"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "State"
        }
      ],
      "alias": "State"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Employees.Count()"
        }
      ],
      "alias": "Headcount"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Employees.CountDistinct(DepartmentId)"
        }
      ],
      "alias": "DepartmentsRepresented"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Employees.CountIf(EmploymentType = <Full-time>)"
        }
      ],
      "alias": "FullTime"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Employees.CountIf(EmploymentType = <Part-time>)"
        }
      ],
      "alias": "PartTime"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Employees.CountIf(EmploymentType = <Contract>)"
        }
      ],
      "alias": "Contractors"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Employees.Average(ElapsedYears(HireDate, <2025-10-31>))"
        }
      ],
      "alias": "AverageTenureYears"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Employees.Sum(Salary)"
        }
      ],
      "alias": "AnnualPayroll"
    }
  ],
  "Filters": null,
  "Sorts": [
    [
      {
        "field": {
          "kind": "field",
          "field": "Headcount"
        },
        "direction": 1
      },
      {
        "field": {
          "kind": "field",
          "field": "AnnualPayroll"
        },
        "direction": 1
      }
    ]
  ],
  "Page": 1,
  "PageSize": 10,
  "IsBuiltin": false,
  "Relations": []
}
