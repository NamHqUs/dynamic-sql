{
  "entity": "Employees",
  "projection": [
    {
      "fields": [
        {
          "kind": "field",
          "field": "Id"
        }
      ],
      "alias": "AgentId"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "Concat",
          "arguments": [
            {
              "kind": "field",
              "field": "FirstName"
            },
            {
              "kind": "value",
              "value": " "
            },
            {
              "kind": "field",
              "field": "LastName"
            }
          ]
        }
      ],
      "alias": "Agent"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Location.City"
        }
      ],
      "alias": "OfficeCity"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "CountDistinct",
          "arguments": [
            {
              "kind": "field",
              "field": "AgentPolicies.Id"
            }
          ]
        }
      ],
      "alias": "PoliciesSold"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "CountIf",
          "arguments": [
            {
              "kind": "field",
              "field": "AgentPolicies.Status = 'Active'"
            }
          ]
        }
      ],
      "alias": "ActivePolicies"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "function",
              "function": "Coalesce",
              "arguments": [
                {
                  "kind": "field",
                  "field": "PaidPayments.PaidPremiums"
                },
                {
                  "kind": "value",
                  "value": 0
                }
              ]
            },
            {
              "kind": "value",
              "value": 2
            }
          ]
        }
      ],
      "alias": "PaidPremiums"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "Coalesce",
          "arguments": [
            {
              "kind": "field",
              "field": "LatePayments.LatePayments"
            },
            {
              "kind": "value",
              "value": 0
            }
          ]
        }
      ],
      "alias": "LatePayments"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "Coalesce",
          "arguments": [
            {
              "kind": "field",
              "field": "MissedPayments.MissedPayments"
            },
            {
              "kind": "value",
              "value": 0
            }
          ]
        }
      ],
      "alias": "MissedPayments"
    }
  ],
  "filter": "Department.Name = 'Insurance Agency'",
  "sorts": [
    {
      "field": "PaidPremiums",
      "direction": "Descending"
    }
  ],
  "page": 1,
  "pageSize": 10,
  "contexts": [
    {
      "name": "PaidPayments",
      "alias": "PaidPayments",
      "joinType": "Left",
      "condition": "Id = PaidPayments.AgentId",
      "query": {
        "entity": "PremiumPayments",
        "projection": [
          {
            "fields": [
              {
                "kind": "field",
                "field": "Policy.AgentId"
              }
            ],
            "alias": "AgentId"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "SUM",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "Amount"
                  }
                ]
              }
            ],
            "alias": "PaidPremiums"
          }
        ],
        "filter": "Status = 'Paid'"
      }
    },
    {
      "name": "LatePayments",
      "alias": "LatePayments",
      "joinType": "Left",
      "condition": "Id = LatePayments.AgentId",
      "query": {
        "entity": "PremiumPayments",
        "projection": [
          {
            "fields": [
              {
                "kind": "field",
                "field": "Policy.AgentId"
              }
            ],
            "alias": "AgentId"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "COUNT",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "Id"
                  }
                ]
              }
            ],
            "alias": "LatePayments"
          }
        ],
        "filter": "Status = 'Late'"
      }
    },
    {
      "name": "MissedPayments",
      "alias": "MissedPayments",
      "joinType": "Left",
      "condition": "Id = MissedPayments.AgentId",
      "query": {
        "entity": "PremiumPayments",
        "projection": [
          {
            "fields": [
              {
                "kind": "field",
                "field": "Policy.AgentId"
              }
            ],
            "alias": "AgentId"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "COUNT",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "Id"
                  }
                ]
              }
            ],
            "alias": "MissedPayments"
          }
        ],
        "filter": "Status = 'Missed'"
      }
    }
  ]
}
