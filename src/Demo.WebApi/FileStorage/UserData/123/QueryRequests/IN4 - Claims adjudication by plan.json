{
  "Name": "IN4 - Claims adjudication by plan",
  "Entity": "InsurancePlans",
  "Projection": [
    {
      "fields": [
        {
          "kind": "field",
          "field": "Name"
        }
      ],
      "alias": "Plan"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Tier"
        }
      ],
      "alias": "Tier"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Policies.Claims.Count()"
        }
      ],
      "alias": "ClaimsReceived"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Policies.Claims.CountIf(Status = <Paid>)"
        }
      ],
      "alias": "PaidClaims"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Policies.Claims.CountIf(Status = <Denied>)"
        }
      ],
      "alias": "DeniedClaims"
    },
    {
      "fields": [
        {
          "kind": "group",
          "fields": [
            {
              "kind": "value",
              "value": 100
            },
            {
              "kind": "field",
              "field": "Policies.Claims.CountIf(Status = <Denied>)",
              "oper": "*"
            }
          ]
        },
        {
          "kind": "function",
          "function": "NULLIF",
          "arguments": [
            {
              "kind": "field",
              "field": "Policies.Claims.Count()"
            },
            {
              "kind": "value",
              "value": 0
            }
          ],
          "oper": "/"
        }
      ],
      "alias": "DenialPercent"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Policies.Claims.AverageIf(ProcessedDate IS NOT NULL, DateSub(ClaimDate, ProcessedDate))"
        }
      ],
      "alias": "AverageProcessingDays"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Policies.Claims.Sum(PaidAmount)"
        }
      ],
      "alias": "TotalPaid"
    }
  ],
  "Filters": null,
  "Sorts": [
    [
      {
        "field": {
          "kind": "field",
          "field": "ClaimsReceived"
        },
        "direction": 1
      }
    ]
  ],
  "Page": 1,
  "PageSize": 10,
  "IsBuiltin": false,
  "Relations": []
}
