{
  "entity": "Employees",
  "projection": [
    {
      "fields": [
        {
          "kind": "field",
          "field": "Id"
        }
      ],
      "alias": "ManagerId"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "Concat",
          "arguments": [
            {
              "kind": "field",
              "field": "FirstName"
            },
            {
              "kind": "value",
              "value": " "
            },
            {
              "kind": "field",
              "field": "LastName"
            }
          ]
        }
      ],
      "alias": "Manager"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Department.Name"
        }
      ],
      "alias": "Department"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "CountDistinct",
          "arguments": [
            {
              "kind": "field",
              "field": "DirectReports.Id"
            }
          ]
        }
      ],
      "alias": "DirectReports"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "CountDistinct",
          "arguments": [
            {
              "kind": "field",
              "field": "DirectReports.LocationId"
            }
          ]
        }
      ],
      "alias": "TeamLocations"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "function",
              "function": "AVG",
              "arguments": [
                {
                  "kind": "field",
                  "field": "DirectReports.Salary"
                }
              ]
            },
            {
              "kind": "value",
              "value": 2
            }
          ]
        }
      ],
      "alias": "AverageTeamSalary"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "field",
              "field": "ReviewSummary.AverageTeamRating"
            },
            {
              "kind": "value",
              "value": 2
            }
          ]
        }
      ],
      "alias": "AverageTeamRating"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "function",
              "function": "SUM",
              "arguments": [
                {
                  "kind": "field",
                  "field": "DirectReports.Salary"
                }
              ]
            },
            {
              "kind": "value",
              "value": 2
            }
          ]
        }
      ],
      "alias": "TeamPayroll"
    }
  ],
  "filter": "DirectReports.Id IS NOT NULL",
  "sorts": [
    {
      "field": "DirectReports",
      "direction": "Descending"
    },
    {
      "field": "TeamPayroll",
      "direction": "Descending"
    }
  ],
  "page": 1,
  "pageSize": 10,
  "contexts": [
    {
      "name": "ReviewSummary",
      "alias": "ReviewSummary",
      "joinType": "Left",
      "condition": "Id = ReviewSummary.ManagerId",
      "query": {
        "entity": "PerformanceReviews",
        "projection": [
          {
            "fields": [
              {
                "kind": "field",
                "field": "Employee.ManagerId"
              }
            ],
            "alias": "ManagerId"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "AVG",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "Rating"
                  }
                ]
              }
            ],
            "alias": "AverageTeamRating"
          }
        ],
        "filter": "ReviewYear = 2025"
      }
    }
  ]
}
