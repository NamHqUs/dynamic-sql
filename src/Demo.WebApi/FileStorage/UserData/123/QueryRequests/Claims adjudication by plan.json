{
  "entity": "Claims",
  "projection": [
    {
      "fields": [
        {
          "kind": "field",
          "field": "Policy.Plan.Name"
        }
      ],
      "alias": "Plan"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Policy.Plan.Tier"
        }
      ],
      "alias": "Tier"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "COUNT",
          "arguments": [
            {
              "kind": "field",
              "field": "Id"
            }
          ]
        }
      ],
      "alias": "ClaimsReceived"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "CountIf",
          "arguments": [
            {
              "kind": "field",
              "field": "Status = 'Paid'"
            }
          ]
        }
      ],
      "alias": "PaidClaims"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "CountIf",
          "arguments": [
            {
              "kind": "field",
              "field": "Status = 'Denied'"
            }
          ]
        }
      ],
      "alias": "DeniedClaims"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "group",
              "fields": [
                {
                  "kind": "value",
                  "value": 100.0
                },
                {
                  "oper": "*",
                  "kind": "function",
                  "function": "CountIf",
                  "arguments": [
                    {
                      "kind": "field",
                      "field": "Status = 'Denied'"
                    }
                  ]
                },
                {
                  "oper": "/",
                  "kind": "function",
                  "function": "COUNT",
                  "arguments": [
                    {
                      "kind": "field",
                      "field": "Id"
                    }
                  ]
                }
              ]
            },
            {
              "kind": "value",
              "value": 2
            }
          ]
        }
      ],
      "alias": "DenialPercent"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "function",
              "function": "AvgIf",
              "arguments": [
                {
                  "kind": "function",
                  "function": "DateSub",
                  "arguments": [
                    {
                      "kind": "field",
                      "field": "ClaimDate"
                    },
                    {
                      "kind": "field",
                      "field": "ProcessedDate"
                    }
                  ]
                },
                {
                  "kind": "field",
                  "field": "ProcessedDate IS NOT NULL"
                }
              ]
            },
            {
              "kind": "value",
              "value": 1
            }
          ]
        }
      ],
      "alias": "AverageProcessingDays"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "function",
              "function": "SUM",
              "arguments": [
                {
                  "kind": "field",
                  "field": "PaidAmount"
                }
              ]
            },
            {
              "kind": "value",
              "value": 2
            }
          ]
        }
      ],
      "alias": "TotalPaid"
    }
  ],
  "sorts": [
    {
      "field": "ClaimsReceived",
      "direction": "Descending"
    }
  ],
  "page": 1,
  "pageSize": 10
}
