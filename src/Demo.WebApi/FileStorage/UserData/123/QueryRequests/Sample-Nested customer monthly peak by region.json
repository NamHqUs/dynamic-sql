{
  "entity": "Users",
  "projection": [
    {
      "fields": [
        {
          "kind": "field",
          "field": "State"
        }
      ],
      "alias": "Region"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "AVG",
          "arguments": [
            {
              "kind": "field",
              "field": "CustomerBestMonth.BestMonthRevenue"
            }
          ]
        }
      ],
      "alias": "AverageBestMonth"
    }
  ],
  "contexts": [
    {
      "name": "CustomerMonth",
      "alias": "CustomerMonth",
      "joinType": "Inner",
      "query": {
        "entity": "Orders",
        "projection": [
          {
            "fields": [
              {
                "kind": "field",
                "field": "UserId"
              }
            ],
            "alias": "UserId"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "Year",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "OrderDate"
                  }
                ]
              }
            ],
            "alias": "SalesYear"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "Month",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "OrderDate"
                  }
                ]
              }
            ],
            "alias": "SalesMonth"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "SUM",
                "arguments": [
                  {
                    "kind": "group",
                    "fields": [
                      {
                        "kind": "field",
                        "field": "Items.Quantity"
                      },
                      {
                        "oper": "*",
                        "kind": "field",
                        "field": "Items.UnitPrice"
                      },
                      {
                        "oper": "-",
                        "kind": "field",
                        "field": "Items.DiscountAmount"
                      }
                    ]
                  }
                ]
              }
            ],
            "alias": "MonthlyRevenue"
          }
        ],
        "filter": "Status = 'Completed'"
      }
    },
    {
      "name": "CustomerBestMonth",
      "alias": "CustomerBestMonth",
      "joinType": "Inner",
      "condition": "Id = CustomerBestMonth.UserId",
      "query": {
        "entity": "CustomerMonth",
        "projection": [
          {
            "fields": [
              {
                "kind": "field",
                "field": "UserId"
              }
            ],
            "alias": "UserId"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "MAX",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "MonthlyRevenue"
                  }
                ]
              }
            ],
            "alias": "BestMonthRevenue"
          }
        ]
      }
    }
  ]
}
