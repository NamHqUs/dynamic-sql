{
  "Name": "HC2 - Physician workload and care-quality scorecard",
  "Entity": "Employees",
  "Projection": [
    {
      "fields": [
        {
          "kind": "field",
          "field": "Id"
        }
      ],
      "alias": "DoctorId"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "CONCAT",
          "arguments": [
            {
              "kind": "field",
              "field": "FirstName"
            },
            {
              "kind": "value",
              "value": " "
            },
            {
              "kind": "field",
              "field": "LastName"
            }
          ]
        }
      ],
      "alias": "Physician"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Department.Name"
        }
      ],
      "alias": "Department"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "Location.City"
        }
      ],
      "alias": "ClinicCity"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "PhysicianVisits.CountIf(Status = <Completed>)"
        }
      ],
      "alias": "VisitCount"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "PhysicianVisits.CountDistinctIf(Status = <Completed>, PersonId)"
        }
      ],
      "alias": "PatientCount"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "PhysicianVisits.AverageIf(Status = <Completed>, DurationMinutes)"
        }
      ],
      "alias": "AverageVisitMinutes"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "PhysicianVisits.SumIf(Status = <Completed>, Charge)"
        }
      ],
      "alias": "Charges"
    },
    {
      "fields": [
        {
          "kind": "group",
          "fields": [
            {
              "kind": "value",
              "value": 100
            },
            {
              "kind": "field",
              "field": "PhysicianVisits.LabResults.CountIf(Visit.Status = <Completed> AND IsAbnormal = <true>)",
              "oper": "*"
            }
          ]
        },
        {
          "kind": "function",
          "function": "NULLIF",
          "arguments": [
            {
              "kind": "field",
              "field": "PhysicianVisits.LabResults.CountIf(Visit.Status = <Completed>)"
            },
            {
              "kind": "value",
              "value": 0
            }
          ],
          "oper": "/"
        }
      ],
      "alias": "AbnormalLabPercent"
    }
  ],
  "Filters": {
    "logicalOperation": 0,
    "filters": [
      {
        "logicalOperator": null,
        "left": {
          "kind": "field",
          "field": "Department.Name"
        },
