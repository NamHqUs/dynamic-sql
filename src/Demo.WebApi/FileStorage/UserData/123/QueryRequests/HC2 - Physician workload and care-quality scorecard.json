              "kind": "value",
              "value": "Primary Care"
            },
            {
              "kind": "value",
              "value": "Specialty Care"
            },
            {
              "kind": "value",
              "value": "Emergency Medicine"
            }
          ]
        },
        "parameterized": true
      }
    ]
  },
  "Sorts": [
    [
      {
        "field": {
          "kind": "field",
          "field": "VisitCount"
        },
        "direction": 1
      },
      {
        "field": {
          "kind": "field",
          "field": "Charges"
        },
        "direction": 1
