{
  "entity": "Users",
  "projection": [
    {
      "fields": [
        {
          "kind": "field",
          "field": "Id"
        }
      ],
      "alias": "PatientId"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "Concat",
          "arguments": [
            {
              "kind": "field",
              "field": "FirstName"
            },
            {
              "kind": "value",
              "value": " "
            },
            {
              "kind": "field",
              "field": "LastName"
            }
          ]
        }
      ],
      "alias": "Patient"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "AgeOn",
          "arguments": [
            {
              "kind": "field",
              "field": "BirthDate"
            },
            {
              "kind": "value",
              "value": "2025-10-31"
            }
          ]
        }
      ],
      "alias": "Age"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "PatientVisits.ChronicVisits"
        }
      ],
      "alias": "ChronicVisits"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "PatientVisits.CompletedVisits"
        }
      ],
      "alias": "CompletedVisits"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "PatientLabs.AbnormalResults"
        }
      ],
      "alias": "AbnormalResults"
    },
    {
      "fields": [
        {
          "kind": "function",
          "function": "ROUND",
          "arguments": [
            {
              "kind": "field",
              "field": "PatientVisits.TotalCharges"
            },
            {
              "kind": "value",
              "value": 2
            }
          ]
        }
      ],
      "alias": "TotalCharges"
    },
    {
      "fields": [
        {
          "kind": "field",
          "field": "PatientVisits.LastVisitDate"
        }
      ],
      "alias": "LastVisitDate"
    }
  ],
  "filter": "PatientVisits.ChronicVisits > 0 AND PatientLabs.AbnormalResults > 0",
  "sorts": [
    {
      "field": "AbnormalResults",
      "direction": "Descending"
    },
    {
      "field": "ChronicVisits",
      "direction": "Descending"
    },
    {
      "field": "TotalCharges",
      "direction": "Descending"
    }
  ],
  "page": 1,
  "pageSize": 10,
  "contexts": [
    {
      "name": "PatientVisits",
      "alias": "PatientVisits",
      "joinType": "Inner",
      "condition": "Id = PatientVisits.UserId",
      "query": {
        "entity": "Visits",
        "projection": [
          {
            "fields": [
              {
                "kind": "field",
                "field": "UserId"
              }
            ],
            "alias": "UserId"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "CountIf",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "Diagnosis.IsChronic = true"
                  }
                ]
              }
            ],
            "alias": "ChronicVisits"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "COUNT",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "Id"
                  }
                ]
              }
            ],
            "alias": "CompletedVisits"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "SUM",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "Charge"
                  }
                ]
              }
            ],
            "alias": "TotalCharges"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "MAX",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "VisitDate"
                  }
                ]
              }
            ],
            "alias": "LastVisitDate"
          }
        ],
        "filter": "Status = 'Completed'"
      }
    },
    {
      "name": "PatientLabs",
      "alias": "PatientLabs",
      "joinType": "Inner",
      "condition": "Id = PatientLabs.UserId",
      "query": {
        "entity": "LabResults",
        "projection": [
          {
            "fields": [
              {
                "kind": "field",
                "field": "Visit.UserId"
              }
            ],
            "alias": "UserId"
          },
          {
            "fields": [
              {
                "kind": "function",
                "function": "CountIf",
                "arguments": [
                  {
                    "kind": "field",
                    "field": "IsAbnormal = true"
                  }
                ]
              }
            ],
            "alias": "AbnormalResults"
          }
        ]
      }
    }
  ]
}
