{
  "Name": "HR1 - Department compensation and performance",
  "Entity": "Departments",
  "Projection": [
    {
      "field": {
        "kind": "field",
        "field": "Name"
      },
      "alias": "Department"
    },
    {
      "field": {
        "kind": "field",
        "field": "Employees.Count()"
      },
      "alias": "Headcount"
    },
    {
      "field": {
        "kind": "field",
        "field": "Employees.Average(Salary)"
      },
      "alias": "AverageSalary"
    },
    {
      "field": {
        "kind": "field",
        "field": "Employees.Sum(Salary)"
      },
      "alias": "AnnualPayroll"
    },
    {
      "field": {
        "kind": "field",
        "field": "Employees.PerformanceReviews.AverageIf(ReviewYear = <2025>, Rating)"
      },
      "alias": "AverageRating"
    },
    {
      "field": {
        "kind": "field",
        "field": "Employees.PerformanceReviews.SumIf(ReviewYear = <2025>, BonusAmount)"
      },
      "alias": "TotalBonuses"
    }
  ],
  "Filters": null,
  "Sorts": [
    [
      {
        "field": {
          "kind": "field",
          "field": "AnnualPayroll"
        },
        "direction": 1
      }
    ]
  ],
  "Page": 1,
  "PageSize": 10,
  "IsBuiltin": false,
  "Relations": []
}
