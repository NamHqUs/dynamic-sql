{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
    }
  },
  "AllowedHosts": "*",

  "DbProvider": {
    "DefaultDbOption": "{DbOptions:0}", /* select default dbconnection */
    "AllowDirectConnections": false,
    "DbScriptsPath": "../../scripts",
    "UseCases": [ "northstar-demo", "unit-test" ] /* unit-test, sale-demo, northstar-demo */
  },

  "DbOptions": [
    {
      "Name": "Sqlite In Memory",
      "ConnectionString": "{ConnectionStrings:Sqlite}",
      "Provider": "Sqlite"
    },
    {
      "Name": "Local SqlServer",
      "ConnectionString": "{ConnectionStrings:SqlServer}",
      "Provider": "SqlServer"
    },
    {
      "Name": "Postgres Docker",
      "ConnectionString": "{ConnectionStrings:Postgres}",
      "Provider": "Postgres"
    }
  ],

  "ConnectionStrings": {
    "Sqlite": "Data Source=:memory:",
    //"SqlServer": "Config in Secret",
    //"Postgres": "Config in Secret"
  },

  "StorageProvider": "Files",
  "FileStoragePath": "FileStorage"
}
