{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "DbProvider": {
    "Default": "Sqlite",
    "DbScriptsPath": "../../scripts",
